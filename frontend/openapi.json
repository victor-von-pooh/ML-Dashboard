  "paths": {
    "/api/projects": {
      "get": {
        "summary": "List Projects",
        "description": "登録したプロジェクトの一覧を返す関数\n\nParameters\n----------\nrequest: Request\n    リクエスト\n\nReturns\n----------\nprojects: list[ProjectInfo]\n    プロジェクトの一覧",
        "operationId": "list_projects",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProjectInfo"
                  },
                  "type": "array",
                  "title": "Response List Projects"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Project",
        "description": "プロジェクトを登録する関数\n\nParameters\n----------\nrequest: Request\n    リクエスト\nbody: ProjectCreate\n    プロジェクトのディレクトリ, 名前, Python\n\nReturns\n----------\ninfo: ProjectInfo\n    登録したプロジェクト",
        "operationId": "create_project",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectInfo"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/scan": {
      "post": {
        "summary": "Scan Projects",
        "description": "ディレクトリの下の ML-Found のプロジェクトを探す関数\n\nParameters\n----------\nrequest: Request\n    リクエスト\nbody: ScanRequest\n    探し始めるディレクトリ\n\nReturns\n----------\ncandidates: list[ProjectCandidate]\n    見つけたプロジェクトと, 登録済みかどうか",
        "operationId": "scan_projects",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanRequest"
              }
            }
          },
          "required": true
